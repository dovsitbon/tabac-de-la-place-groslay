---
// Emplacement photo : aplat de la palette + légende du cliché attendu (voir PHOTOS_A_PRENDRE.md).
interface Props { legende: string; numero: string; class?: string; ton?: 'rouge' | 'zinc' | 'creme' | 'noir' }
const { legende, numero, class: cls = '', ton = 'zinc' } = Astro.props;
---
<figure class:list={['photo', `ton-${ton}`, cls]} role="img" aria-label={`Emplacement photo : ${legende}`}>
  <span class="cadre" aria-hidden="true"></span>
  <figcaption>
    <span class="num">Photo {numero} à prendre</span>
    <span class="leg">{legende}</span>
  </figcaption>
</figure>
<style>
  .photo { position: relative; margin: 0; display: flex; align-items: flex-end; padding: 1rem; overflow: hidden; border: 2px solid var(--color-noir); }
  .cadre { position: absolute; inset: 10px; border: 1px dashed currentColor; opacity: .45; pointer-events: none; }
  figcaption { position: relative; display: grid; gap: .2rem; max-width: 32ch; }
  .num { font-family: var(--font-affiche); font-size: 1.05rem; letter-spacing: .02em; }
  .leg { font-size: .95rem; line-height: 1.45; font-style: italic; }
  .ton-rouge { background: var(--color-carotte); color: var(--color-creme); }
  .ton-zinc { background: var(--color-zinc-fonce); color: var(--color-creme); }
  .ton-creme { background: var(--color-creme); color: var(--color-noir); }
  .ton-noir { background: #2a2c2e; color: var(--color-creme); }
</style>
