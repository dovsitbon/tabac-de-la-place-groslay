---
import Carotte from './Carotte.astro';
import { SITE, HORAIRES, fmtPlages, LOI_EVIN } from '../data/site';
---
<footer class="sombre bg-noir text-creme pt-14 pb-28 md:pb-12">
  <div class="wrap grid gap-10 md:grid-cols-[auto_1fr_1fr_1fr]">
    <Carotte class="w-[38px] h-auto hidden md:block" />
    <div>
      <p class="font-affiche text-[1.6rem] leading-none">{SITE.nom}</p>
      <p class="mt-3">Café-bar-tabac<br />{SITE.adresse.rue}<br />{SITE.adresse.cp} {SITE.adresse.ville}</p>
      <p class="mt-3"><a href={`tel:${SITE.telLien}`} class="inline-flex min-h-[44px] items-center underline underline-offset-4">{SITE.telAffiche}</a></p>
    </div>
    <div>
      <p class="font-affiche text-[1.15rem] tracking-[.02em]">Horaires habituels</p>
      <ul class="mt-2 text-[.95rem]">
        {HORAIRES.map((h) => <li class="flex justify-between gap-4 max-w-[17rem]"><span>{h.nom}</span><span class="tabular-nums">{fmtPlages(h.plages)}</span></li>)}
      </ul>
      <p class="mt-2 text-[.9rem]">Fermetures exceptionnelles : voir <a href="/#infos" class="underline underline-offset-4">l’affichette du jour</a>.</p>
    </div>
    <div class="text-[.95rem]">
      <ul class="space-y-0">
        <li><a href="/mentions-legales/" class="inline-flex min-h-[44px] items-center underline underline-offset-4">Mentions légales</a></li>
        <li><a href="/confidentialite/" class="inline-flex min-h-[44px] items-center underline underline-offset-4">Confidentialité</a></li>
        <li><a href={SITE.itineraire} class="inline-flex min-h-[44px] items-center underline underline-offset-4" target="_blank" rel="noopener">Itinéraire Google Maps</a></li>
      </ul>
      <p class="mt-4">{LOI_EVIN}</p>
      <p class="mt-2">Vente de tabac et d’alcool interdite aux mineurs.</p>
    </div>
  </div>
</footer>
