---
import { SITE } from '../data/site';
---
<div class="barre md:hidden fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t-2 border-noir bg-zinc-clair px-3 pt-2 pb-[calc(.5rem+env(safe-area-inset-bottom))]">
  <a href={`tel:${SITE.telLien}`} class="btn btn-rouge !shadow-none" aria-label={`Appeler le ${SITE.telAffiche}`}>Appeler</a>
  <a href={SITE.itineraire} class="btn btn-creme !shadow-none" target="_blank" rel="noopener">Itinéraire</a>
</div>
